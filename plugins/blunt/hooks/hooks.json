{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/context/communication.md\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/PostToolUse/answer-questions-in-asks.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/Stop/no-git-noise.mjs\""
          },
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/Stop/no-check-noise.mjs\""
          },
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/Stop/no-label-leads.mjs\""
          },
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/Stop/no-prose-asks.mjs\""
          },
          {
            "type": "command",
            "command": "env -u NODE_USE_SYSTEM_CA node \"${CLAUDE_PLUGIN_ROOT}/hooks/Stop/no-file-lists.mjs\""
          }
        ]
      }
    ]
  },
  "modules": [
    "./render/hide-refused-draft.tsx"
  ]
}
